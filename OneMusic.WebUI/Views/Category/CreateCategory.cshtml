@model Category
@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h3>Yeni Kategori Ekle</h3>

<form method="post">
    <label>Kategori Adı</label>
    <input type="text" asp-for="CategoryName" class="form-control" />
    <span class="text-danger" asp-validation-for="CategoryName"></span>
    <br />
    <button class="btn btn-outline-primary">Kaydet</button>
</form>
