@model Message
<section class="contact-area section-padding-100 bg-img bg-overlay bg-fixed has-bg-img" style="background-image: url(/one-music-gh-pages/img/bg-img/bg-2.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-heading white wow fadeInUp" data-wow-delay="100ms">
                   
                    <h2>Bizimle iletişime geçin</h2>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <!-- Contact Form Area -->
                <div class="contact-form-area">
                    <form id="messageForm" asp-controller="Default" asp-action="SendMessage" method="post" onsubmit="return sendMessage(event)">
                        <div class="row">
                            <div class="col-md-6 col-lg-4">
                                <div class="form-group wow fadeInUp" data-wow-delay="100ms">
                                    <input type="text" class="form-control" asp-for="Name" placeholder="Adınız" required>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="form-group wow fadeInUp" data-wow-delay="200ms">
                                    <input type="email" class="form-control" asp-for="Email" placeholder="E-mail" required>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="form-group wow fadeInUp" data-wow-delay="300ms">
                                    <input type="text" class="form-control" asp-for="Subject" placeholder="Konu" required>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group wow fadeInUp" data-wow-delay="400ms">
                                    <textarea class="form-control" asp-for="Content" cols="30" rows="10" placeholder="Mesajınızı Yazın" required></textarea>
                                </div>
                            </div>
                            <div class="col-12 text-center wow fadeInUp" data-wow-delay="500ms">
                                <button class="btn oneMusic-btn mt-30" type="submit">Mesajı Gönder <i class="fa fa-angle-double-right"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    // Formu sayfa yenilenmeden gönderir, sonucu SweetAlert ile gösterir
    function sendMessage(e) {
        e.preventDefault();
        var form = document.getElementById("messageForm");
        fetch(form.action, { method: "POST", body: new FormData(form) })
            .then(function (response) {
                if (!response.ok) {
                    throw new Error();
                }
                form.reset();
                Swal.fire({
                    title: "Tebrikler",
                    text: "Mesajınız Gönderildi!",
                    icon: "success",
                    confirmButtonColor: "#3085d6",
                    confirmButtonText: "Tamam"
                });
            })
            .catch(function () {
                Swal.fire({
                    title: "Hata",
                    text: "Mesajınız gönderilemedi, lütfen tüm alanları doldurunuz.",
                    icon: "error",
                    confirmButtonText: "Tamam"
                });
            });
        return false;
    }
</script>
