@{
    Layout = null;
    @using Microsoft.AspNetCore.Identity
    @inject UserManager<AppUser> UserManager
    @inject SignInManager<AppUser> SignInManager

}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- The above 4 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <!-- Title -->
    <title>Server Music - Modern Music HTML5 Template</title>

    <!-- Favicon -->
    <link rel="icon" href="~/one-music-gh-pages/img/core-img/favicon.ico">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="~/one-music-gh-pages/style.css">
    <style>
        /* Favori (kalp) butonu */
        .favorite-btn {
            background: none;
            border: none;
            padding: 6px 8px;
            font-size: 22px;
            line-height: 1;
            color: #9e9e9e;
            cursor: pointer;
            transition: transform .15s ease, color .15s ease;
        }
        .favorite-btn:hover { color: #e63946; transform: scale(1.15); }
        .favorite-btn.active { color: #e63946; }
        .favorite-btn:focus-visible { outline: 2px solid #e63946; outline-offset: 2px; border-radius: 4px; }
        .favorite-btn.pop { animation: favorite-pop .3s ease; }
        @@keyframes favorite-pop { 50% { transform: scale(1.35); } }
    </style>

</head>

<body>
    @* Favori butonlarının POST isteği için güvenlik anahtarı *@
    @Html.AntiForgeryToken()
    <!-- Preloader -->
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="lds-ellipsis">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>

    <!-- ##### Header Area Start ##### -->
    <header class="header-area">
       
        <!-- Navbar Area -->
        <div class="oneMusic-main-menu">
            <div class="classy-nav-container breakpoint-off">
                <div class="container">
                    <!-- Menu -->
                    <nav class="classy-navbar justify-content-between" id="oneMusicNav">

                        <!-- Nav brand -->
                        <a href="/" class="nav-brand"><img src="~/one-music-gh-pages/img/core-img/logo.png" alt=""></a>

                        <!-- Navbar Toggler -->
                        <div class="classy-navbar-toggler">
                            <span class="navbarToggler"><span></span><span></span><span></span></span>
                        </div>

                        <!-- Menu -->
                        <div class="classy-menu">

                            <!-- Close Button -->
                            <div class="classycloseIcon">
                                <div class="cross-wrap"><span class="top"></span><span class="bottom"></span></div>
                            </div>

                            <!-- Nav Start -->
                            <div class="classynav">
                                <ul>
                                    <li>@Html.ActionLink("Ana Sayfa", "Index", "Default")</li>
                                    <li>@Html.ActionLink("Albümler", "Index", "Albums")</li>
                                    <li>@Html.ActionLink("Sanatçılar", "Index", "Singer")</li>
                                    <li><a href="event.html">Etkinlikler</a></li>
                                    <li>@Html.ActionLink("İletişim","Index","Contact")</li>
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <li><a href="/Favorite/Index"><i class="fa fa-heart" aria-hidden="true"></i> Favori Müziklerim</a></li>
                                    }

                                    @* Artist için özel menü öğeleri *@
                                    @if (ViewBag.IsArtist == true)
                                    {
                                        <li><a href="/Artist/MyAlbum/Index">Artist Paneli</a></li>
                                    }

                                    @if (ViewBag.IsAdmin == true)
                                    {
                                        <li><a href="/AdminAbout/Index">Admin Paneli</a></li>
                                    }
                                </ul>

                                <!-- Login/Register & Logout -->
                                <div class="login-register-cart-button d-flex align-items-center">
                                    @if (!SignInManager.IsSignedIn(User))
                                    {
                                        <div class="login-register-btn mr-50">
                                            @Html.ActionLink("Giriş Yap / Kayıt Ol", "Index", "Login", null, new { @class = "btn btn-outline-light" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="login-register-btn mr-50">
                                            <a href="/Login/Logout" class="btn btn-outline-light">Çıkış Yap</a>
                                        </div>
                                    }
                                </div>
                            </div>
                            <!-- Nav End -->
                        </div>
                    </nav>
                </div>
            </div>
        </div>


                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>
    <!-- ##### Header Area End ##### -->
    @RenderBody()
    <!-- ##### Footer Area Start ##### -->
    <footer class="footer-area">
        <div class="container">
            <div class="row d-flex flex-wrap align-items-center">
                <div class="col-12 col-md-6">
                    <a href="#"><img src="img/core-img/logo.png" alt=""></a>
                    <p class="copywrite-text">
                        <a href="#">
                            <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                            Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
                            <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </p>
                </div>

                <div class="col-12 col-md-6">
                    <div class="footer-nav">
                        <ul>
                            <li><a href="#">Home</a></li>
                            <li><a href="#">Albums</a></li>
                            <li><a href="#">Events</a></li>
                            <li><a href="#">News</a></li>
                            <li><a href="#">Contact</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- ##### Footer Area Start ##### -->
    <!-- ##### All Javascript Script ##### -->
    <!-- jQuery-2.2.4 js -->
    <script src="~/one-music-gh-pages/js/jquery/jquery-2.2.4.min.js"></script>
    <!-- Popper js -->
    <script src="~/one-music-gh-pages/js/bootstrap/popper.min.js"></script>
    <!-- Bootstrap js -->
    <script src="~/one-music-gh-pages/js/bootstrap/bootstrap.min.js"></script>
    <!-- All Plugins js -->
    <script src="~/one-music-gh-pages/js/plugins/plugins.js"></script>
    <!-- Active js -->
    <script src="~/one-music-gh-pages/js/active.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Kalbe tıklanınca şarkıyı favorilere ekler / çıkarır (sayfa yenilenmeden)
        document.addEventListener("click", function (e) {
            var btn = e.target.closest("button.favorite-btn");
            if (!btn) return;

            var songId = btn.dataset.songId;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            btn.disabled = true;

            fetch("/Favorite/Toggle", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "songId=" + encodeURIComponent(songId) + "&__RequestVerificationToken=" + encodeURIComponent(token)
            })
                .then(function (response) {
                    if (!response.ok) throw new Error();
                    return response.json();
                })
                .then(function (data) {
                    // Aynı şarkı sayfada birden fazla yerde olabilir, hepsini güncelle
                    document.querySelectorAll('button.favorite-btn[data-song-id="' + songId + '"]').forEach(function (b) {
                        b.classList.toggle("active", data.isFavorite);
                        b.setAttribute("aria-pressed", data.isFavorite ? "true" : "false");
                        b.title = data.isFavorite ? "Favorilerden çıkar" : "Favorilere ekle";
                        var icon = b.querySelector("i");
                        icon.className = "fa " + (data.isFavorite ? "fa-heart" : "fa-heart-o");
                        b.classList.remove("pop"); void b.offsetWidth; b.classList.add("pop");
                    });

                    // Favori Müziklerim sayfasındaysak çıkarılan şarkıyı listeden kaldır
                    if (!data.isFavorite) {
                        var row = document.querySelector('[data-favorite-row="' + songId + '"]');
                        if (row) {
                            row.remove();
                            if (!document.querySelector("[data-favorite-row]")) {
                                document.getElementById("favoriteEmpty").style.display = "";
                            }
                        }
                    }
                })
                .catch(function () {
                    Swal.fire({ title: "Hata", text: "İşlem yapılamadı, lütfen tekrar deneyin.", icon: "error", confirmButtonText: "Tamam" });
                })
                .finally(function () {
                    btn.disabled = false;
                });
        });
    </script>
</body>

</html>