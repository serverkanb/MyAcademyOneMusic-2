@model Album
@{
    ViewData["Title"] = "CreateAlbum";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<h2>Yeni Albüm Ekle</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label>Albüm Adı</label>
        <input type="text" asp-for="AlbumName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Fiyat</label>
        <input type="number" step="0.01" asp-for="Price" class="form-control" />
    </div>

    <div class="form-group">
        <label>Kapak Resmi (URL)</label>
        <input type="text" asp-for="CoverImage" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Çıkış Tarihi</label>
        <input type="date" asp-for="RelaseDate" class="form-control" />
    </div>

    <div class="form-check mt-2">
        <input type="checkbox" asp-for="IsNewAlbum" class="form-check-input" />
        <label class="form-check-label" asp-for="IsNewAlbum">Yeni Albüm</label>
    </div>

    <div class="form-group">
        <label>Sanatçı</label>
        <select asp-for="SingerId" asp-items="ViewBag.singers" class="form-control">
            <option value="">Sanatçı Seçiniz</option>
        </select>
    </div>

    <div class="form-group">
        <label>Kategori</label>
        <select asp-for="CategoryId" asp-items="ViewBag.categories" class="form-control">
            <option value="">Kategori Seçiniz</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Kaydet</button>
</form>
