@model List<Playlist>
@{
    ViewData["Title"] = "Çalma Listelerim";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- ##### Breadcumb Area Start ##### -->
<section class="breadcumb-area bg-img bg-overlay" style="background-image: url(/one-music-gh-pages/img/bg-img/breadcumb2.jpg);">
    <div class="bradcumbContent">
        <p>Kendi müzik listelerini oluştur</p>
        <h2>Çalma Listelerim</h2>
    </div>
</section>
<!-- ##### Breadcumb Area End ##### -->

<section class="section-padding-100">
    <div class="container">

        <!-- Yeni liste formu -->
        <div class="row mb-50">
            <div class="col-12">
                <div class="playlist-create">
                    <h5 class="mb-3">Yeni Çalma Listesi</h5>
                    @if (TempData["playlistError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["playlistError"]</div>
                    }
                    <form asp-action="Create" method="post" class="form-row align-items-end">
                        <div class="col-md-4 mb-2">
                            <label for="playlistName" class="small mb-1">Liste adı</label>
                            <input id="playlistName" type="text" name="Name" class="form-control" maxlength="100" placeholder="Örn. Yolculuk Şarkıları" required />
                        </div>
                        <div class="col-md-6 mb-2">
                            <label for="playlistDescription" class="small mb-1">Açıklama (isteğe bağlı)</label>
                            <input id="playlistDescription" type="text" name="Description" class="form-control" maxlength="500" placeholder="Bu liste ne için?" />
                        </div>
                        <div class="col-md-2 mb-2">
                            <button type="submit" class="btn btn-dark btn-block" style="height:calc(1.5em + .75rem + 2px)"><i class="fa fa-plus" aria-hidden="true"></i> Oluştur</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Listeler -->
        @if (Model.Any())
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    var count = item.PlaylistSongs?.Count ?? 0;
                    <div class="col-12 col-sm-6 col-lg-4 mb-30">
                        <a class="playlist-card" href="/Playlist/Detail/@item.PlaylistId">
                            <div class="playlist-card-icon"><i class="fa fa-music" aria-hidden="true"></i></div>
                            <div class="playlist-card-body">
                                <h5>@item.Name</h5>
                                <p class="playlist-card-count">@count şarkı</p>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="playlist-card-desc">@item.Description</p>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa fa-music" style="font-size:48px;color:#ccc" aria-hidden="true"></i>
                <h5 class="mt-3">Henüz bir çalma listen yok</h5>
                <p>Yukarıdan ilk listeni oluştur ya da şarkıların yanındaki <i class="fa fa-plus" aria-hidden="true"></i> butonuyla ekle.</p>
            </div>
        }
    </div>
</section>
