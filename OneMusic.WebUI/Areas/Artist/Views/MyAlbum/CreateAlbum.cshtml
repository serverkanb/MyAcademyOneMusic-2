@model Album
@{
    ViewData["Title"] = "CreateAlbum";
    Layout = "~/Areas/Artist/Views/ArtistLayout/Index.cshtml";
}

<h3>Yeni Albüm Oluşturma Sayfası</h3>
<br />

<form method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<label>Albüm Adı</label>
<input type="text" asp-for="AlbumName" class="form-control" />
<br />
<label>Albüm Kapak Resmi</label>
<input type="text" asp-for="CoverImage" class="form-control" />
<br />
<label>Fiyat</label>
<input type="number" step="0.01" asp-for="Price" class="form-control" />
<br />
<label>Kategori</label>
<select asp-for="CategoryId" asp-items="ViewBag.categories" class="form-control">
    <option value="">Kategori Seçiniz</option>
</select>
<br />
 

<button class="btn btn-outline-primary">Kaydet</button>
</form>