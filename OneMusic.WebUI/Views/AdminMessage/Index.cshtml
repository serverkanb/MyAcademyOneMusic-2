@model List<Message>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<h3>Gelen Mesajlar</h3>

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Ad</th>
        <th>Email</th>
        <th>Konu</th>
        <th>Mesaj</th>
        <th>İşlemler</th>
    </tr>

    @foreach (var item in Model)
    {
        count++;
        <tr>
            <th>@count</th>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Subject</td>
            <td>@item.Content</td>
            <td>
                <a class="btn btn-outline-danger" asp-action="DeleteMessage" asp-route-id="@item.MessageId" onclick="return confirm('Mesaj silinsin mi?')">Sil</a>
            </td>
        </tr>
    }
</table>
