@model Category
@{
    ViewData["Title"] = "Kategori Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<h3>Kategori Güncelle</h3>

<form method="post">
    <input type="hidden" asp-for="CategoryId" />
    <label>Kategori Adı</label>
    <input type="text" asp-for="CategoryName" class="form-control" />
    <span class="text-danger" asp-validation-for="CategoryName"></span>
    <br />
    <button class="btn btn-outline-primary">Güncelle</button>
</form>
