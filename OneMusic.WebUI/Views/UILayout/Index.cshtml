@{
    Layout = null;
    @using Microsoft.AspNetCore.Identity
    @inject UserManager<AppUser> UserManager
    @inject SignInManager<AppUser> SignInManager

}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!-- The above 4 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <!-- Title -->
    <title>Server Music - Modern Music HTML5 Template</title>

    <!-- Favicon -->
    <link rel="icon" href="~/one-music-gh-pages/img/core-img/favicon.ico">

    <!-- Stylesheet -->
    <link rel="stylesheet" href="~/one-music-gh-pages/style.css">
    <style>
        /* Favori (kalp) butonu */
        .favorite-btn {
            background: none;
            border: none;
            padding: 6px 8px;
            font-size: 22px;
            line-height: 1;
            color: #9e9e9e;
            cursor: pointer;
            transition: transform .15s ease, color .15s ease;
        }
        .favorite-btn:hover { color: #e63946; transform: scale(1.15); }
        .favorite-btn.active { color: #e63946; }
        .favorite-btn:focus-visible { outline: 2px solid #e63946; outline-offset: 2px; border-radius: 4px; }
        .favorite-btn.pop { animation: favorite-pop .3s ease; }
        @@keyframes favorite-pop { 50% { transform: scale(1.35); } }

        /* Çalma listesine ekle (+) butonu */
        .playlist-add-btn {
            background: none;
            border: none;
            padding: 6px 8px;
            font-size: 20px;
            line-height: 1;
            color: #9e9e9e;
            cursor: pointer;
            transition: transform .15s ease, color .15s ease;
        }
        .playlist-add-btn:hover { color: #000; transform: scale(1.15); }
        .playlist-add-btn:focus-visible { outline: 2px solid #000; outline-offset: 2px; border-radius: 4px; }

        /* Çalma listesi penceresi */
        #playlistModal .playlist-option {
            display: flex; align-items: center; justify-content: space-between;
            width: 100%; padding: 12px 14px; margin-bottom: 8px;
            background: #f7f7f7; border: 1px solid #eee; border-radius: 6px;
            text-align: left; cursor: pointer; transition: background .15s ease;
        }
        #playlistModal .playlist-option:hover { background: #efefef; }
        #playlistModal .playlist-option .meta { color: #888; font-size: 13px; }
        #playlistModal .playlist-option .state { font-size: 18px; color: #ccc; }
        #playlistModal .playlist-option.selected { border-color: #000; background: #fff; }
        #playlistModal .playlist-option.selected .state { color: #000; }
        #playlistModal .playlist-status { min-height: 20px; font-size: 13px; color: #888; }

        /* Çalma Listelerim sayfası */
        .playlist-create { background: #f7f7f7; padding: 24px; border-radius: 8px; }
        .playlist-card {
            display: flex; align-items: center; height: 100%;
            padding: 20px; border: 1px solid #eee; border-radius: 8px; background: #fff;
            color: inherit; transition: box-shadow .15s ease, transform .15s ease;
        }
        .playlist-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.08); transform: translateY(-2px); color: inherit; }
        .playlist-card-icon {
            flex: 0 0 64px; height: 64px; margin-right: 16px; border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #222, #555); color: #fff; font-size: 26px;
        }
        .playlist-card-body h5 { margin-bottom: 4px; word-break: break-word; }
        .playlist-card-count { margin: 0; color: #888; font-size: 13px; }
        .playlist-card-desc { margin: 6px 0 0; font-size: 13px; color: #555; }
        .playlist-index { width: 28px; color: #999; font-size: 14px; }
        .playlist-cover { width: 56px; height: 56px; object-fit: cover; margin-right: 15px; }
        .playlist-song.now-playing { background: #f4f4f4; border-left: 3px solid #000; }
        .playlist-remove-btn { background: none; border: none; padding: 6px 8px; font-size: 18px; color: #9e9e9e; cursor: pointer; }
        .playlist-remove-btn:hover { color: #e63946; }
        .small-link { font-size: inherit; font-weight: normal; color: inherit; text-decoration: underline; }
        @@media (max-width: 575px) { .playlist-audio { max-width: 200px; } }
    </style>

</head>

<body>
    @* Favori butonlarının POST isteği için güvenlik anahtarı *@
    @Html.AntiForgeryToken()
    <!-- Preloader -->
    <div class="preloader d-flex align-items-center justify-content-center">
        <div class="lds-ellipsis">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </div>
    </div>

    <!-- ##### Header Area Start ##### -->
    <header class="header-area">
       
        <!-- Navbar Area -->
        <div class="oneMusic-main-menu">
            <div class="classy-nav-container breakpoint-off">
                <div class="container">
                    <!-- Menu -->
                    <nav class="classy-navbar justify-content-between" id="oneMusicNav">

                        <!-- Nav brand -->
                        <a href="/" class="nav-brand"><img src="~/one-music-gh-pages/img/core-img/logo.png" alt=""></a>

                        <!-- Navbar Toggler -->
                        <div class="classy-navbar-toggler">
                            <span class="navbarToggler"><span></span><span></span><span></span></span>
                        </div>

                        <!-- Menu -->
                        <div class="classy-menu">

                            <!-- Close Button -->
                            <div class="classycloseIcon">
                                <div class="cross-wrap"><span class="top"></span><span class="bottom"></span></div>
                            </div>

                            <!-- Nav Start -->
                            <div class="classynav">
                                <ul>
                                    <li>@Html.ActionLink("Ana Sayfa", "Index", "Default")</li>
                                    <li>@Html.ActionLink("Albümler", "Index", "Albums")</li>
                                    <li>@Html.ActionLink("Sanatçılar", "Index", "Singer")</li>
                                    <li><a href="event.html">Etkinlikler</a></li>
                                    <li>@Html.ActionLink("İletişim","Index","Contact")</li>
                                    @if (SignInManager.IsSignedIn(User))
                                    {
                                        <li><a href="/Favorite/Index"><i class="fa fa-heart" aria-hidden="true"></i> Favori Müziklerim</a></li>
                                        <li><a href="/Playlist/Index"><i class="fa fa-list" aria-hidden="true"></i> Çalma Listelerim</a></li>
                                    }

                                    @* Artist için özel menü öğeleri *@
                                    @if (ViewBag.IsArtist == true)
                                    {
                                        <li><a href="/Artist/MyAlbum/Index">Artist Paneli</a></li>
                                    }

                                    @if (ViewBag.IsAdmin == true)
                                    {
                                        <li><a href="/AdminAbout/Index">Admin Paneli</a></li>
                                    }
                                </ul>

                                <!-- Login/Register & Logout -->
                                <div class="login-register-cart-button d-flex align-items-center">
                                    @if (!SignInManager.IsSignedIn(User))
                                    {
                                        <div class="login-register-btn mr-50">
                                            @Html.ActionLink("Giriş Yap / Kayıt Ol", "Index", "Login", null, new { @class = "btn btn-outline-light" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="login-register-btn mr-50">
                                            <a href="/Login/Logout" class="btn btn-outline-light">Çıkış Yap</a>
                                        </div>
                                    }
                                </div>
                            </div>
                            <!-- Nav End -->
                        </div>
                    </nav>
                </div>
            </div>
        </div>


                        </div>
                    </nav>
                </div>
            </div>
        </div>
    </header>
    <!-- ##### Header Area End ##### -->
    @RenderBody()
    <!-- ##### Footer Area Start ##### -->
    <footer class="footer-area">
        <div class="container">
            <div class="row d-flex flex-wrap align-items-center">
                <div class="col-12 col-md-6">
                    <a href="#"><img src="img/core-img/logo.png" alt=""></a>
                    <p class="copywrite-text">
                        <a href="#">
                            <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                            Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
                            <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </p>
                </div>

                <div class="col-12 col-md-6">
                    <div class="footer-nav">
                        <ul>
                            <li><a href="#">Home</a></li>
                            <li><a href="#">Albums</a></li>
                            <li><a href="#">Events</a></li>
                            <li><a href="#">News</a></li>
                            <li><a href="#">Contact</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- ##### Footer Area Start ##### -->
    <!-- ##### All Javascript Script ##### -->
    <!-- jQuery-2.2.4 js -->
    <script src="~/one-music-gh-pages/js/jquery/jquery-2.2.4.min.js"></script>
    <!-- Popper js -->
    <script src="~/one-music-gh-pages/js/bootstrap/popper.min.js"></script>
    <!-- Bootstrap js -->
    <script src="~/one-music-gh-pages/js/bootstrap/bootstrap.min.js"></script>
    <!-- All Plugins js -->
    <script src="~/one-music-gh-pages/js/plugins/plugins.js"></script>
    <!-- Active js -->
    <script src="~/one-music-gh-pages/js/active.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Çalma listesine ekle penceresi -->
        <div class="modal fade" id="playlistModal" tabindex="-1" role="dialog" aria-labelledby="playlistModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="playlistModalTitle">Çalma listesine ekle</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <div id="playlistOptions"></div>
                        <div class="playlist-status" id="playlistStatus" role="status" aria-live="polite"></div>
                        <form id="newPlaylistForm" class="mt-3">
                            <label for="newPlaylistName" class="small mb-1">Yeni liste oluştur ve ekle</label>
                            <div class="input-group">
                                <input type="text" id="newPlaylistName" class="form-control" maxlength="100" placeholder="Liste adı" required />
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-dark">Oluştur</button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <a href="/Playlist/Index" class="mr-auto small">Çalma Listelerime git</a>
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Tamam</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // Şarkının yanındaki (+) butonu: kullanıcının listelerini gösterir, tek tıkla ekler/çıkarır
            (function () {
                var currentSongId = null;
                var optionsEl = document.getElementById("playlistOptions");
                var statusEl = document.getElementById("playlistStatus");

                function token() {
                    return document.querySelector('input[name="__RequestVerificationToken"]').value;
                }
                function post(url, data) {
                    data.__RequestVerificationToken = token();
                    return fetch(url, {
                        method: "POST",
                        headers: { "Content-Type": "application/x-www-form-urlencoded" },
                        body: new URLSearchParams(data).toString()
                    });
                }
                function setStatus(text) { statusEl.textContent = text || ""; }

                function render(playlists) {
                    optionsEl.innerHTML = "";
                    if (!playlists.length) {
                        var empty = document.createElement("p");
                        empty.className = "text-muted mb-0";
                        empty.textContent = "Henüz bir çalma listen yok. Aşağıdan ilkini oluştur.";
                        optionsEl.appendChild(empty);
                        return;
                    }
                    playlists.forEach(function (p) {
                        var btn = document.createElement("button");
                        btn.type = "button";
                        btn.className = "playlist-option" + (p.containsSong ? " selected" : "");
                        btn.setAttribute("aria-pressed", p.containsSong ? "true" : "false");

                        var left = document.createElement("span");
                        var name = document.createElement("strong");
                        name.textContent = p.name; // textContent: kullanıcı girdisi HTML olarak yorumlanmaz
                        var meta = document.createElement("div");
                        meta.className = "meta";
                        meta.textContent = p.songCount + " şarkı";
                        left.appendChild(name); left.appendChild(meta);

                        var state = document.createElement("i");
                        state.className = "state fa " + (p.containsSong ? "fa-check-circle" : "fa-circle-thin");
                        state.setAttribute("aria-hidden", "true");

                        btn.appendChild(left); btn.appendChild(state);
                        btn.addEventListener("click", function () { toggle(p, btn, meta, state); });
                        optionsEl.appendChild(btn);
                    });
                }

                function load() {
                    setStatus("Yükleniyor...");
                    fetch("/Playlist/ForSong?songId=" + encodeURIComponent(currentSongId))
                        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                        .then(function (data) { setStatus(""); render(data); })
                        .catch(function () { setStatus("Listeler yüklenemedi."); });
                }

                function toggle(p, btn, meta, state) {
                    btn.disabled = true;
                    post("/Playlist/ToggleSong", { playlistId: p.id, songId: currentSongId })
                        .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                        .then(function (data) {
                            p.containsSong = data.inPlaylist;
                            p.songCount += data.inPlaylist ? 1 : -1;
                            btn.classList.toggle("selected", data.inPlaylist);
                            btn.setAttribute("aria-pressed", data.inPlaylist ? "true" : "false");
                            state.className = "state fa " + (data.inPlaylist ? "fa-check-circle" : "fa-circle-thin");
                            meta.textContent = p.songCount + " şarkı";
                            setStatus(data.inPlaylist ? "“" + p.name + "” listesine eklendi." : "“" + p.name + "” listesinden çıkarıldı.");
                        })
                        .catch(function () { setStatus("İşlem yapılamadı, tekrar deneyin."); })
                        .finally(function () { btn.disabled = false; });
                }

                document.getElementById("newPlaylistForm").addEventListener("submit", function (e) {
                    e.preventDefault();
                    var input = document.getElementById("newPlaylistName");
                    var name = input.value.trim();
                    if (!name) return;
                    post("/Playlist/CreateWithSong", { name: name, songId: currentSongId })
                        .then(function (r) {
                            if (!r.ok) return r.text().then(function (t) { throw new Error(t); });
                            return r.json();
                        })
                        .then(function (data) {
                            input.value = "";
                            load();
                            setTimeout(function () { setStatus("“" + data.name + "” oluşturuldu ve şarkı eklendi."); }, 300);
                        })
                        .catch(function (err) { setStatus(err.message || "Liste oluşturulamadı."); });
                });

                document.addEventListener("click", function (e) {
                    var btn = e.target.closest("button.playlist-add-btn");
                    if (!btn) return;
                    currentSongId = btn.dataset.songId;
                    optionsEl.innerHTML = "";
                    $("#playlistModal").modal("show");
                    load();
                });
            })();
        </script>
    }

    <script>
        // Kalbe tıklanınca şarkıyı favorilere ekler / çıkarır (sayfa yenilenmeden)
        document.addEventListener("click", function (e) {
            var btn = e.target.closest("button.favorite-btn");
            if (!btn) return;

            var songId = btn.dataset.songId;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            btn.disabled = true;

            fetch("/Favorite/Toggle", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "songId=" + encodeURIComponent(songId) + "&__RequestVerificationToken=" + encodeURIComponent(token)
            })
                .then(function (response) {
                    if (!response.ok) throw new Error();
                    return response.json();
                })
                .then(function (data) {
                    // Aynı şarkı sayfada birden fazla yerde olabilir, hepsini güncelle
                    document.querySelectorAll('button.favorite-btn[data-song-id="' + songId + '"]').forEach(function (b) {
                        b.classList.toggle("active", data.isFavorite);
                        b.setAttribute("aria-pressed", data.isFavorite ? "true" : "false");
                        b.title = data.isFavorite ? "Favorilerden çıkar" : "Favorilere ekle";
                        var icon = b.querySelector("i");
                        icon.className = "fa " + (data.isFavorite ? "fa-heart" : "fa-heart-o");
                        b.classList.remove("pop"); void b.offsetWidth; b.classList.add("pop");
                    });

                    // Favori Müziklerim sayfasındaysak çıkarılan şarkıyı listeden kaldır
                    if (!data.isFavorite) {
                        var row = document.querySelector('[data-favorite-row="' + songId + '"]');
                        if (row) {
                            row.remove();
                            if (!document.querySelector("[data-favorite-row]")) {
                                document.getElementById("favoriteEmpty").style.display = "";
                            }
                        }
                    }
                })
                .catch(function () {
                    Swal.fire({ title: "Hata", text: "İşlem yapılamadı, lütfen tekrar deneyin.", icon: "error", confirmButtonText: "Tamam" });
                })
                .finally(function () {
                    btn.disabled = false;
                });
        });
    </script>
</body>

</html>